# Copia este archivo como .env para cambiar los valores de docker-compose.yml.

# production | staging | development. Con development el navegador llama directo a
# http://localhost:8080/api/v1, y el backend solo acepta CORS desde http://localhost:4200.
BUILD_CONFIGURATION=development

# Puerto local donde se publica el frontend con nginx.
FRONTEND_PORT=4200

# URL del backend vista desde el contenedor (sin "/" final).
BACKEND_URL=http://host.docker.internal:8080
